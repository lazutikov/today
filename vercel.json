{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/checkin",
      "schedule": "0 8 * * *"
    }
  ],
  "functions": {
    "api/sender.ts": {
      "maxDuration": 60
    },
    "api/trusted.ts": {
      "maxDuration": 30
    },
    "api/safety.ts": {
      "maxDuration": 30
    }
  }
}

VITE_TG_BOT_NAME=      # bot username without @
VITE_POSTHOG_KEY=      # PostHog project API key (phc_...)
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Server only (Vercel → Settings → Environment Variables). Never commit it.
TELEGRAM_BOT_TOKEN=
